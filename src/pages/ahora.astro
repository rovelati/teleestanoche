---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getOnNowPrograms } from '../utils/epg';

const nowItems = getOnNowPrograms();

const pageTitle = "Ahora en TV | ¿Qué echan ahora en directo en la tele?";
const pageDesc = "Consulta qué están emitiendo ahora mismo en la tele en España. Programas en directo, informativos, series y películas en emisión en los canales de la TDT.";
const keywords = "ahora en tv, que echan ahora en la tele, en directo tv hoy, emision en directo tdt, guia tv ahora, canales tdt directo espana";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Ahora en TV - Emisión en Directo TDT España",
  "url": "https://www.teleestanoche.es/ahora/",
  "description": pageDesc,
  "inLanguage": "es-ES",
  "spatialCoverage": {
    "@type": "Country",
    "name": "España",
    "identifier": "ES"
  }
};
---

<BaseLayout title={pageTitle} description={pageDesc} keywords={keywords} jsonLd={jsonLd}>
  <Header activeTab="now" />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Hero Header -->
    <div class="mb-8 border-b border-slate-800 pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>En Emisión en Directo</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Ahora en TV
        </h1>
        <p class="text-sm sm:text-base text-slate-400 mt-2 max-w-2xl">
          Descubre qué programa está en emisión ahora mismo en cada canal y cuánto tiempo le queda para terminar.
        </p>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-2xl px-4 py-3 flex items-center gap-3">
        <span class="text-2xl">⏱️</span>
        <div>
          <span class="text-[11px] text-slate-400 block font-medium">Hora peninsular</span>
          <span class="text-sm font-bold text-white font-mono" id="live-clock">
            --:--:--
          </span>
        </div>
      </div>
    </div>

    <!-- On Now Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {nowItems.map(({ channel, current, next, progressPercent }) => (
        <div class="bg-slate-900/80 hover:bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-2xl p-5 flex flex-col justify-between transition-all duration-200">
          
          <div>
            <!-- Channel Header -->
            <div class="flex items-center justify-between gap-3 mb-4 pb-3 border-b border-slate-800/80">
              <a href={`/${channel.id}/`} class="flex items-center gap-3 hover:opacity-85 transition-opacity">
                <div class="w-10 h-10 bg-slate-950 rounded-xl p-1.5 flex items-center justify-center border border-slate-800 shrink-0">
                  <img src={channel.logo} alt={channel.name} class="max-h-full max-w-full object-contain" loading="lazy" />
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="text-xs font-bold px-1.5 py-0.5 rounded bg-slate-800 text-slate-400">
                      #{channel.number}
                    </span>
                    <span class="font-bold text-white text-sm">
                      {channel.name}
                    </span>
                  </div>
                  <span class="text-[11px] text-emerald-400 font-semibold flex items-center gap-1 mt-0.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    En emisión
                  </span>
                </div>
              </a>

              {current && (
                <div class="text-right shrink-0">
                  <span class="text-xs font-mono font-bold text-amber-400" data-time-madrid={`${current.startMadrid} - ${current.stopMadrid}`} data-time-canarias={`${current.startCanarias} - ${current.stopCanarias}`}>
                    {current.startMadrid} - {current.stopMadrid}
                  </span>
                </div>
              )}
            </div>

            <!-- Current Program -->
            {current ? (
              <div class="space-y-3">
                <div>
                  <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-800 text-slate-300">
                    {current.categoryEs}
                  </span>
                  <h3 class="text-base font-bold text-white leading-snug mt-1.5 line-clamp-2">
                    {current.title}
                  </h3>
                </div>

                <!-- Progress Bar -->
                <div>
                  <div class="w-full bg-slate-800 rounded-full h-1.5 overflow-hidden">
                    <div 
                      class="bg-amber-400 h-1.5 rounded-full transition-all duration-500" 
                      style={`width: ${progressPercent}%`}
                    ></div>
                  </div>
                  <div class="flex justify-between items-center text-[10px] text-slate-500 mt-1">
                    <span data-time-madrid={current.startMadrid} data-time-canarias={current.startCanarias}>{current.startMadrid}</span>
                    <span class="font-semibold text-slate-400">{progressPercent}% completado</span>
                    <span data-time-madrid={current.stopMadrid} data-time-canarias={current.stopCanarias}>{current.stopMadrid}</span>
                  </div>
                </div>

                {current.description && (
                  <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
                    {current.description}
                  </p>
                )}
              </div>
            ) : (
              <p class="text-xs text-slate-500 py-4 text-center">Emisión no disponible</p>
            )}

            <!-- Next Program -->
            {next && (
              <div class="mt-4 pt-3 border-t border-slate-800/60 text-[11px] text-slate-400 flex items-center justify-between">
                <span class="truncate">
                  <strong class="text-slate-300">Siguiente:</strong> {next.title}
                </span>
                <span class="shrink-0 text-slate-500 font-mono ml-2" data-time-madrid={next.startMadrid} data-time-canarias={next.startCanarias}>
                  {next.startMadrid}
                </span>
              </div>
            )}
          </div>

          <!-- Direct Stream Button -->
          <div class="mt-5 pt-3 border-t border-slate-800/80 flex items-center justify-between">
            <a 
              href={`/${channel.id}/`} 
              class="text-xs text-slate-300 hover:text-white font-medium hover:underline"
            >
              Ver parrilla completa →
            </a>
            <a 
              href={channel.streamUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white transition-colors"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
              <span>Ver directo oficial</span>
              <span class="text-[10px] text-slate-400">↗</span>
            </a>
          </div>

        </div>
      ))}
    </div>

  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  (function() {
    function updateClock() {
      const el = document.getElementById('live-clock');
      if (!el) return;
      const now = new Date();
      el.textContent = now.toLocaleTimeString('es-ES', { timeZone: 'Europe/Madrid' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  })();
</script>
