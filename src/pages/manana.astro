---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChannelCard from '../components/ChannelCard.astro';
import { getTomorrowPrograms } from '../utils/epg';

const tomorrowItems = getTomorrowPrograms();

const pageTitle = "Programación TV Mañana | Guía de televisión para mañana en España";
const pageDesc = "Consulta la programación de televisión de mañana en España. Qué echan mañana por la noche en La 1, Antena 3, Telecinco, Cuatro, laSexta y canales de la TDT.";
const keywords = "programacion tv manana, que echan manana en la tele, guia tv manana espana, peliculas manana tv, esta noche manana tv";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Programación TV Mañana - TDT España",
  "url": "https://www.teleestanoche.es/manana/",
  "description": pageDesc,
  "inLanguage": "es-ES",
  "spatialCoverage": {
    "@type": "Country",
    "name": "España",
    "identifier": "ES"
  }
};
---

<BaseLayout title={pageTitle} description={pageDesc} keywords={keywords} jsonLd={jsonLd}>
  <Header activeTab="tomorrow" />

  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Hero Header -->
    <div class="mb-8 border-b border-slate-800 pb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-400 text-xs font-semibold mb-3">
        <span>📅</span>
        <span>Adelanto de Mañana</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Programación TV Mañana
      </h1>
      <p class="text-sm sm:text-base text-slate-400 mt-2 max-w-2xl">
        Descubre con antelación los programas, películas y series estelares que se emitirán mañana en el Prime Time de los canales en abierto.
      </p>
    </div>

    <!-- Grid -->
    {tomorrowItems.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tomorrowItems.map(({ channel, program }) => (
          <ChannelCard 
            channel={channel} 
            program={program} 
          />
        ))}
      </div>
    ) : (
      <div class="py-16 text-center text-slate-400 bg-slate-900/40 rounded-2xl border border-slate-800">
        <span class="text-4xl block mb-2">📅</span>
        <h3 class="text-base font-bold text-white mb-1">Parrilla de mañana en proceso de actualización</h3>
        <p class="text-xs text-slate-500">Los operadores de televisión cierran las franjas nocturnas con pocas horas de antelación.</p>
      </div>
    )}

  </main>

  <Footer />
</BaseLayout>
