---
import type { Channel, Program } from '../types/epg';
import BookmarkButton from './BookmarkButton.astro';

interface Props {
  channel: Channel;
  program?: Program;
  nextProgram?: Program;
  showChannelLink?: boolean;
}

const { channel, program, nextProgram, showChannelLink = true } = Astro.props;

const categoryColors: Record<string, string> = {
  movies: 'bg-amber-500/20 text-amber-300 border-amber-500/30',
  sports: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30',
  series: 'bg-purple-500/20 text-purple-300 border-purple-500/30',
  news: 'bg-blue-500/20 text-blue-300 border-blue-500/30',
  kids: 'bg-sky-500/20 text-sky-300 border-sky-500/30',
  entertainment: 'bg-pink-500/20 text-pink-300 border-pink-500/30',
};

const badgeClass = program ? (categoryColors[program.category] || categoryColors.entertainment) : '';

const CATEGORY_FALLBACKS: Record<string, string> = {
  movies: 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=600&q=80',
  series: 'https://images.unsplash.com/photo-1522869635100-9f4c5e86aa37?auto=format&fit=crop&w=600&q=80',
  sports: 'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=600&q=80',
  news: 'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?auto=format&fit=crop&w=600&q=80',
  kids: 'https://images.unsplash.com/photo-1513542789411-b6a5d4f31634?auto=format&fit=crop&w=600&q=80',
  entertainment: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=600&q=80'
};

const photoUrl = program?.icon || (program ? CATEGORY_FALLBACKS[program.category] : '');
---

<div 
  id={`channel-card-${channel.id}`}
  class="channel-card group bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-3xl p-4 sm:p-5 transition-all duration-200 shadow-lg relative overflow-hidden scroll-mt-24"
  data-channel-id={channel.id}
  data-category={program?.category || 'entertainment'}
>
  <!-- GRID VIEW LAYOUT (Shown when container has .view-grid) -->
  <div class="card-grid-view flex flex-col justify-between h-full">
    <div>
      <!-- Top Bar: Channel Header & Bookmark Button -->
      <div class="flex items-center justify-between gap-3 mb-3 pb-3 border-b border-slate-800/80">
        
        <!-- Channel Info -->
        <a href={`/${channel.id}/`} class="flex items-center gap-3 hover:opacity-85 transition-opacity" title={`Ver programación completa de ${channel.name}`}>
          <div class="w-10 h-10 bg-slate-950 rounded-xl p-1.5 flex items-center justify-center border border-slate-800 shrink-0">
            <img 
              src={channel.logo} 
              alt={channel.name} 
              class="max-h-full max-w-full object-contain"
              loading="lazy"
            />
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-bold px-1.5 py-0.5 rounded bg-slate-800 text-slate-400">
                #{channel.number}
              </span>
              <span class="font-bold text-white text-sm group-hover:text-amber-400 transition-colors">
                {channel.name}
              </span>
            </div>
            <span class="text-[11px] text-slate-400 block truncate max-w-[140px]">
              TDT España
            </span>
          </div>
        </a>

        <!-- Actions: Bookmark -->
        <div class="flex items-center gap-1.5">
          <BookmarkButton channelSlug={channel.id} />
        </div>
      </div>

      <!-- Clickable Program Area (Opens Modal) -->
      {program ? (
        <div 
          class="program-clickable cursor-pointer block rounded-2xl transition-all"
          data-channel-slug={channel.id}
          data-channel-name={channel.name}
          data-channel-logo={channel.logo}
          data-title={program.title}
          data-desc={program.description}
          data-category={program.categoryEs}
          data-start={program.startTime}
          data-end={program.stopTime}
          data-image={photoUrl}
          data-stream-url={channel.streamUrl}
          onclick="openProgramModal(this)"
          title="Toca para ver detalles completos y guardar recordatorio"
        >
          <!-- Program Photo Banner with zoom effect -->
          <div class="relative h-40 sm:h-44 w-full bg-slate-950 rounded-2xl overflow-hidden mb-3.5 border border-slate-800/80 group-hover:border-slate-700 transition-colors">
            <img 
              src={photoUrl} 
              alt={program.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
              onerror={`this.onerror=null; this.src='${CATEGORY_FALLBACKS[program.category] || CATEGORY_FALLBACKS.entertainment}';`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>

            <!-- Category Badge on Photo -->
            <div class="absolute top-2.5 left-2.5">
              <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-lg border backdrop-blur-md shadow-sm ${badgeClass}`}>
                {program.categoryEs}
              </span>
            </div>

            <!-- Time Badge on Photo -->
            <div class="absolute bottom-2.5 right-2.5">
              <span class="inline-flex items-center gap-1 text-xs font-mono font-bold text-amber-300 bg-slate-950/90 border border-slate-700/80 px-2.5 py-1 rounded-lg backdrop-blur-md shadow">
                <span>🕒</span>
                <span data-time-madrid={`${program.startMadrid} - ${program.stopMadrid}`} data-time-canarias={`${program.startCanarias} - ${program.stopCanarias}`}>
                  {program.startMadrid} - {program.stopMadrid}
                </span>
              </span>
            </div>
          </div>

          <!-- Title & Synopsis -->
          <div class="space-y-1.5">
            <h3 class="text-base font-bold text-white leading-snug line-clamp-2 group-hover:text-amber-300 transition-colors">
              {program.title}
            </h3>

            {program.description && (
              <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
                {program.description}
              </p>
            )}

            <div class="pt-1 flex items-center justify-between text-[11px] text-amber-400 font-medium">
              <span class="flex items-center gap-1">
                <span>🔍</span> Ver ficha y recordatorio
              </span>
              <span class="text-slate-500 font-normal">{program.durationMinutes} min</span>
            </div>
          </div>
        </div>
      ) : (
        <div class="py-12 text-center text-xs text-slate-500">
          Información de emisión no disponible
        </div>
      )}

      <!-- Next Program Teaser -->
      {nextProgram && (
        <div class="mt-3 pt-3 border-t border-slate-800/60 text-[11px] text-slate-400 flex items-center justify-between">
          <span class="truncate">
            <strong class="text-slate-300">A continuación:</strong> {nextProgram.title}
          </span>
          <span class="shrink-0 text-slate-500 font-mono ml-2" data-time-madrid={nextProgram.startMadrid} data-time-canarias={nextProgram.startCanarias}>
            {nextProgram.startMadrid}
          </span>
        </div>
      )}
    </div>

    <!-- Bottom Action Buttons -->
    <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between gap-2">
      {showChannelLink && (
        <a 
          href={`/${channel.id}/`} 
          class="text-xs text-slate-300 hover:text-white font-medium hover:underline flex items-center gap-1"
        >
          <span>Parrilla hoy</span>
          <span>→</span>
        </a>
      )}
      
      <a 
        href={channel.streamUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="ml-auto inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white transition-colors border border-slate-700/60"
        title={`Ver ${channel.name} en directo en su web oficial`}
      >
        <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
        <span>Directo</span>
        <span class="text-[10px] text-slate-400">↗</span>
      </a>
    </div>
  </div>

  <!-- LIST VIEW LAYOUT (Shown when container has .view-list) -->
  <div class="card-list-view hidden">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      
      <!-- Col 1: Channel Info & Bookmark (Fixed width on desktop) -->
      <div class="flex items-center justify-between md:justify-start gap-3 md:w-48 shrink-0">
        <a href={`/${channel.id}/`} class="flex items-center gap-2.5 group">
          <div class="w-10 h-10 bg-slate-950 rounded-xl p-1.5 flex items-center justify-center border border-slate-800 shrink-0">
            <img src={channel.logo} alt={channel.name} class="max-h-full max-w-full object-contain" loading="lazy" />
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-bold px-1.5 py-0.5 rounded bg-slate-800 text-slate-400">
                #{channel.number}
              </span>
              <span class="font-bold text-white text-sm group-hover:text-amber-400 transition-colors">
                {channel.name}
              </span>
            </div>
            <span class="text-[10px] text-slate-500 block truncate">TDT España</span>
          </div>
        </a>
        <BookmarkButton channelSlug={channel.id} />
      </div>

      <!-- Col 2: Program Info with Thumbnail & Zoom effect -->
      {program ? (
        <div 
          class="flex-1 flex items-center gap-4 cursor-pointer min-w-0"
          data-channel-slug={channel.id}
          data-channel-name={channel.name}
          data-channel-logo={channel.logo}
          data-title={program.title}
          data-desc={program.description}
          data-category={program.categoryEs}
          data-start={program.startTime}
          data-end={program.stopTime}
          data-image={photoUrl}
          data-stream-url={channel.streamUrl}
          onclick="openProgramModal(this)"
        >
          <!-- Compact Thumbnail with zoom effect -->
          <div class="w-24 sm:w-28 h-16 sm:h-20 rounded-xl overflow-hidden bg-slate-950 border border-slate-800 shrink-0 relative group">
            <img 
              src={photoUrl} 
              alt={program.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
              onerror={`this.onerror=null; this.src='${CATEGORY_FALLBACKS[program.category] || CATEGORY_FALLBACKS.entertainment}';`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 to-transparent"></div>
            <span class={`absolute bottom-1 left-1 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.2 rounded border ${badgeClass}`}>
              {program.categoryEs}
            </span>
          </div>

          <!-- Title & Synopsis in list view -->
          <div class="space-y-1 min-w-0 flex-1">
            <h3 class="text-sm sm:text-base font-bold text-white group-hover:text-amber-300 transition-colors truncate">
              {program.title}
            </h3>
            {program.description && (
              <p class="text-xs text-slate-400 line-clamp-1 leading-relaxed hidden sm:block">
                {program.description}
              </p>
            )}
            <div class="flex items-center gap-2 text-[11px] text-slate-500">
              <span class="text-amber-400 font-semibold flex items-center gap-1">
                <span>🔍</span> Ver ficha
              </span>
              <span>•</span>
              <span>{program.durationMinutes} min</span>
              {nextProgram && (
                <span class="hidden lg:inline text-slate-500 truncate">
                  • <strong>Luego:</strong> {nextProgram.title} ({nextProgram.startMadrid})
                </span>
              )}
            </div>
          </div>
        </div>
      ) : (
        <div class="flex-1 text-xs text-slate-500 py-2">
          Sin emisión programada
        </div>
      )}

      <!-- Col 3: Time Badge & Action Buttons -->
      <div class="flex items-center justify-between md:justify-end gap-3 shrink-0 pt-2 md:pt-0 border-t md:border-t-0 border-slate-800/60">
        {program && (
          <span class="inline-flex items-center gap-1 text-xs font-mono font-bold text-amber-300 bg-slate-950 border border-slate-800 px-3 py-1.5 rounded-xl">
            <span>🕒</span>
            <span data-time-madrid={`${program.startMadrid} - ${program.stopMadrid}`} data-time-canarias={`${program.startCanarias} - ${program.stopCanarias}`}>
              {program.startMadrid} - {program.stopMadrid}
            </span>
          </span>
        )}

        <div class="flex items-center gap-2">
          {showChannelLink && (
            <a 
              href={`/${channel.id}/`} 
              class="hidden sm:inline-block text-xs text-slate-400 hover:text-white px-2.5 py-1.5 rounded-lg hover:bg-slate-800 transition-colors"
            >
              Parrilla
            </a>
          )}
          <a 
            href={channel.streamUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white transition-colors border border-slate-700/60"
            title={`Ver directo oficial`}
          >
            <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
            <span>Directo</span>
            <span class="text-[10px] text-slate-400">↗</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  /* CSS to toggle between Grid View and List View based on container class */
  :global(#channels-grid.view-list) .card-grid-view {
    display: none !important;
  }
  :global(#channels-grid.view-list) .card-list-view {
    display: block !important;
  }
  :global(#channels-grid.view-list) .channel-card {
    border-radius: 1.25rem !important;
    padding: 0.875rem 1.25rem !important;
  }

  :global(#channels-grid.view-grid) .card-grid-view {
    display: flex !important;
  }
  :global(#channels-grid.view-grid) .card-list-view {
    display: none !important;
  }
</style>
