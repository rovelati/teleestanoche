---
import type { Channel, Program } from '../types/epg';

interface Props {
  channel: Channel;
  program?: Program;
  nextProgram?: Program;
  showChannelLink?: boolean;
}

const { channel, program, nextProgram, showChannelLink = true } = Astro.props;

const categoryColors: Record<string, string> = {
  movies: 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  sports: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
  series: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  news: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  kids: 'bg-sky-500/10 text-sky-400 border-sky-500/20',
  entertainment: 'bg-pink-500/10 text-pink-400 border-pink-500/20',
};

const badgeClass = program ? (categoryColors[program.category] || categoryColors.entertainment) : '';
---

<div 
  class="channel-card group bg-slate-900/80 hover:bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-2xl p-5 transition-all duration-200 flex flex-col justify-between shadow-sm relative overflow-hidden"
  data-channel-id={channel.id}
  data-category={program?.category || 'entertainment'}
>
  <div>
    <!-- Top Bar: Channel Header & Time -->
    <div class="flex items-center justify-between gap-3 mb-4 pb-3 border-b border-slate-800/80">
      
      <!-- Channel Info -->
      <a href={`/${channel.id}/`} class="flex items-center gap-3 hover:opacity-85 transition-opacity" title={`Ver programación completa de ${channel.name}`}>
        <div class="w-10 h-10 bg-slate-950 rounded-xl p-1.5 flex items-center justify-center border border-slate-800 shrink-0">
          <img 
            src={channel.logo} 
            alt={channel.name} 
            class="max-h-full max-w-full object-contain"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <span class="hidden text-xs font-bold text-slate-300">{channel.name}</span>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-bold px-1.5 py-0.5 rounded bg-slate-800 text-slate-400">
              #{channel.number}
            </span>
            <span class="font-bold text-white text-sm group-hover:text-amber-400 transition-colors">
              {channel.name}
            </span>
          </div>
          <span class="text-[11px] text-slate-400 block truncate max-w-[140px]">
            TDT España
          </span>
        </div>
      </a>

      <!-- Time Badge -->
      {program && (
        <div class="text-right shrink-0">
          <span class="inline-flex items-center gap-1 text-xs font-bold text-amber-400 bg-amber-400/10 border border-amber-400/20 px-2 py-0.5 rounded-lg">
            <span>🕒</span>
            <span data-time-madrid={`${program.startMadrid} - ${program.stopMadrid}`} data-time-canarias={`${program.startCanarias} - ${program.stopCanarias}`}>
              {program.startMadrid} - {program.stopMadrid}
            </span>
          </span>
          <span class="text-[10px] text-slate-500 block mt-0.5 font-medium">
            {program.durationMinutes} min
          </span>
        </div>
      )}
    </div>

    <!-- Program Content -->
    {program ? (
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class={`text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md border ${badgeClass}`}>
            {program.categoryEs}
          </span>
        </div>

        <h3 class="text-base font-bold text-white leading-snug line-clamp-2 group-hover:text-amber-300 transition-colors">
          {program.title}
        </h3>

        {program.description && (
          <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
            {program.description}
          </p>
        )}
      </div>
    ) : (
      <div class="py-6 text-center text-xs text-slate-500">
        Información de emisión no disponible
      </div>
    )}

    <!-- Next Program Teaser (if any) -->
    {nextProgram && (
      <div class="mt-4 pt-3 border-t border-slate-800/60 text-[11px] text-slate-400 flex items-center justify-between">
        <span class="truncate">
          <strong class="text-slate-300">A continuación:</strong> {nextProgram.title}
        </span>
        <span class="shrink-0 text-slate-500 font-mono ml-2" data-time-madrid={nextProgram.startMadrid} data-time-canarias={nextProgram.startCanarias}>
          {nextProgram.startMadrid}
        </span>
      </div>
    )}
  </div>

  <!-- Bottom Action Buttons -->
  <div class="mt-5 pt-3 border-t border-slate-800/80 flex items-center justify-between gap-2">
    {showChannelLink && (
      <a 
        href={`/${channel.id}/`} 
        class="text-xs text-slate-300 hover:text-white font-medium hover:underline flex items-center gap-1"
      >
        <span>Parrilla hoy</span>
        <span>→</span>
      </a>
    )}
    
    <a 
      href={channel.streamUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="ml-auto inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white transition-colors border border-slate-700/60"
      title={`Ver ${channel.name} en directo en su web oficial`}
    >
      <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
      <span>Directo</span>
      <span class="text-[10px] text-slate-400">↗</span>
    </a>
  </div>
</div>
